



.role-remove-button {
    width: 24px;
    height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
}



#Container > #foldout-container > #role-foldout > .unity-foldout__toggle {
    padding-top: 3px;
    -unity-font-style: bold;
}

.role-row {
    flex-grow: 1;
    position: absolute;
    left: 0;
    height: 25px;
    width: 100%;
    flex-direction: row-reverse;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

#Container > #foldout-container > #role-foldout > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    -unity-background-image-tint-color: rgb(56, 56, 56);
}

#Container > #foldout-container > #role-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    background-color: rgb(56, 56, 56);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    -unity-font-style: bold;
}

#Container > #foldout-container > #role-foldout > .unity-foldout__toggle > .unity-foldout__input {
    width: auto;
    flex-grow: 0;
}

.container {
    flex-direction: row;
    flex-grow: 1;
    width: 60%;
    align-self: auto;
    margin-bottom: 0;
    padding-top: 4px;
}

#Container > #foldout-container > #role-foldout > #unity-content {
    padding-top: 4px;
}
