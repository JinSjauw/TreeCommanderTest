.role-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(56, 56, 56);
}

.role-label {
    flex-grow: 1;
    color: rgb(217, 217, 217);
    -unity-text-align: middle-left;
}

.role-remove-button {
    width: 24px;
    height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
}
