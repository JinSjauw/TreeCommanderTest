<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/BehaviourTree/Editor/UIDocuments/SquadEditor/RoleRow.uss?fileID=7433441132597879392&amp;guid=1958ff1b3e601814a9cfc7fabe102dfa&amp;type=3#RoleRow"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: row; margin-top: 4px; margin-bottom: 4px;">
        <ui:VisualElement name="background-row" class="role-row" style="padding-top: 4px; height: 27px;">
            <ui:VisualElement name="role-color-banner" style="flex-grow: 1; background-color: rgb(135, 49, 49); width: auto; flex-direction: column; margin-right: 50px; border-top-left-radius: 4px; border-top-right-radius: 0; border-bottom-left-radius: 4px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="foldout-container" class="container" style="padding-top: 0;">
            <ui:Foldout name="role-foldout" text="ROLE NAME" style="flex-grow: 1; -unity-font-style: normal;">
                <ui:IntegerField label="Max Amount:" value="1" tooltip="Max amount of this role in a single squad" name="max-amount-field" style="width: 100%; margin-bottom: 4px; padding-right: 12px;"/>
                <ui:Toggle label="Is Fallback:" tooltip="If no available roles, use this role" name="is-fallback-toggle"/>
                <uie:ObjectField label="Prefab:" type="UnityEngine.GameObject, UnityEngine.CoreModule" allow-scene-objects="false" name="prefab-field"/>
                <ui:VisualElement name="separator" style="flex-grow: 1; border-bottom-width: 1px; border-left-color: rgb(240, 240, 240); border-right-color: rgb(240, 240, 240); border-top-color: rgb(240, 240, 240); border-bottom-color: rgb(240, 240, 240); padding-bottom: 3px; padding-top: 6px;"/>
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="control-container" style="flex-grow: 1; flex-direction: row; height: 25px; align-self: flex-start; background-color: rgb(56, 56, 56); padding-bottom: 1px; padding-top: 1px; margin-top: 3px;">
            <uie:ColorField value="rgb(0, 255, 255)" name="role-color-picker" style="width: 40px;"/>
            <ui:Button text="X" name="role-remove-button" class="role-remove-button" style="flex-direction: row; height: 25px; width: 25px; align-self: auto; align-content: auto; right: 2px; position: absolute; top: 0; flex-shrink: 0; margin-bottom: 0; padding-bottom: 0; padding-top: 0; margin-top: 0; margin-right: 0; padding-right: 0; background-color: rgb(240, 89, 95); padding-left: 0; margin-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
