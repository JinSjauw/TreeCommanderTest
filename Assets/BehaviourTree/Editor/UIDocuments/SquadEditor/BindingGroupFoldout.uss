:root {
}

.unity-button {
    min-height: 25px;
}

.binding-control-button {
    min-height: 30px;
    -unity-font-style: bold;
}

#binding-rows-container {
    padding-right: 12px;
    padding-left: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(56, 56, 56);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

#binding-group-foldout > #unity-content {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

#binding-group-foldout > .unity-foldout__toggle {
    background-color: rgb(82, 82, 82);
    margin-bottom: 0;
    margin-right: 0;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-left-radius: 4px;
    border-right-width: 0;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}





#binding-group-foldout > .unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    -unity-font-style: bold;
}
