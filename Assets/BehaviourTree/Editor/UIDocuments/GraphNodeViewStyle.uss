#input {
    min-height: 2px;
    background-color: rgb(128, 128, 128);
    justify-content: flex-start;
    align-content: flex-start;
    align-self: stretch;
    flex-grow: 1;
    min-width: 100%;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#output {
    align-items: center;
    justify-content: center;
    align-content: center;
    flex-direction: row;
    align-self: center;
    min-height: 2px;
    max-height: none;
    padding-bottom: 5px;
    min-width: 100%;
    flex-grow: 1;
}

#text-container {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(96, 96, 96);
    border-right-color: rgb(96, 96, 96);
    border-top-color: rgb(96, 96, 96);
    border-bottom-color: rgb(96, 96, 96);
    height: auto;
    width: 100%;
    align-self: center;
    align-content: center;
    justify-content: center;
    align-items: center;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
    margin-left: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-grow: 1;
}

#node-body {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    align-items: stretch;
    justify-content: center;
    align-self: stretch;
    align-content: center;
    flex-grow: 1;
    min-height: 120px;
    min-width: 150px;
}

#status-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.node-running {
    border-top-color: rgb(255, 204, 51);
    border-right-color: rgb(255, 204, 51);
    border-bottom-color: rgb(255, 204, 51);
    border-left-color: rgb(255, 204, 51);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-timing-function: ease-in-cubic;
    transition-delay: 0s;
    transition-duration: 0.3s;
}

.node-success {
    border-top-color: rgb(0, 255, 0);
    border-right-color: rgb(0, 255, 0);
    border-bottom-color: rgb(0, 255, 0);
    border-left-color: rgb(0, 255, 0);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-timing-function: ease-in;
    transition-delay: 0s;
    transition-duration: 0s;
}

.node-failure {
    border-top-color: rgb(255, 64, 64);
    border-right-color: rgb(255, 64, 64);
    border-bottom-color: rgb(255, 64, 64);
    border-left-color: rgb(255, 64, 64);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-timing-function: ease-in;
    transition-delay: 0s;
    transition-duration: 0s;
}

.node-none {
    transition-duration: 1.5s;
    transition-timing-function: ease-out;
    transition-delay: 0s;
}

:hover > #node-body {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 95, 255);
    border-right-color: rgb(0, 95, 255);
    border-top-color: rgb(0, 95, 255);
    border-bottom-color: rgb(0, 95, 255);
}

:selected > #node-body {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 95, 255);
    border-right-color: rgb(0, 95, 255);
    border-top-color: rgb(0, 95, 255);
    border-bottom-color: rgb(0, 95, 255);
}

:hover:selected > #node-body {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 166, 255);
    border-right-color: rgb(0, 166, 255);
    border-top-color: rgb(0, 166, 255);
    border-bottom-color: rgb(0, 166, 255);
}

.node {
    min-width: 150px;
    align-items: center;
    align-content: center;
    align-self: center;
    justify-content: center;
}

.port > Label {
    display: none;
    visibility: hidden;
}

.port {
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.connectorBox {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
}

.connectorCap {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
}

#node-body > #text-container > #node-title-field > #unity-text-input {
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(96, 96, 96, 0);
    border-right-color: rgba(96, 96, 96, 0);
    border-top-color: rgba(96, 96, 96, 0);
    border-bottom-color: rgba(96, 96, 96, 0);
    font-size: 13px;
}

.node-order-number {
    display: none;
    -unity-font-style: normal;
    position: absolute;
    top: -25px;
    left: 10px;
    font-size: 12px;
    background-color: rgba(42, 42, 42, 0.3);
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 5px;
    margin-left: 2px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
}

.node-order-number:hover {
    -unity-font-style: normal;
    position: absolute;
    top: -25px;
    left: 10px;
    font-size: 12px;
    background-color: rgba(26, 26, 26, 0.8);
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 5px;
    margin-left: 2px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    transition-duration: 0.2s;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}
