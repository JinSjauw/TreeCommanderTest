.tracked-row {
    flex-direction: row;
    align-items: center;
    min-height: auto;
    flex-grow: 1;
    background-color: rgb(56, 56, 56);
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-top: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.tracked-row__num {
    width: 24px;
    font-size: 11px;
    color: rgb(120, 120, 120);
}

.tracked-cell {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    min-width: 60px;
    max-width: 45%;
}

.tracked-cell-button {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 25px;
}

.tracked-row__arrow {
    width: 20px;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    -unity-font-style: bold;
}

.tracked-row__remove {
    width: 22px;
    height: 20px;
    margin-left: 0;
    margin-right: 0;
    min-width: auto;
    min-height: auto;
    flex-shrink: 0;
    background-color: rgb(240, 89, 95);
    border-left-color: rgb(217, 54, 68);
    border-right-color: rgb(217, 54, 68);
    border-top-color: rgb(217, 54, 68);
    border-bottom-color: rgb(217, 54, 68);
    -unity-font-style: bold;
    color: rgb(232, 223, 223);
    -unity-text-align: middle-center;
}

.tracked-row__remove:hover {
    background-color: rgb(240, 126, 131);
}

.tracked-row--invalid {
    background-color: rgb(255, 255, 160);
}


