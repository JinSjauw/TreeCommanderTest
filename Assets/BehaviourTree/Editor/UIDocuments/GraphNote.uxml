<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/BehaviourTree/Editor/UIDocuments/GraphNote.uss?fileID=7433441132597879392&amp;guid=473d0f8f03d958346849695f5074bd17&amp;type=3#GraphNote"/>
    <ui:VisualElement name="note-container" style="flex-grow: 1; padding-top: 0; padding-bottom: 0;">
        <ui:VisualElement name="note-grab-header" style="flex-grow: 0; height: 30px; min-height: 20px; background-color: rgb(255, 170, 0); border-top-right-radius: 8px; border-top-left-radius: 8px;">
            <ui:VisualElement name="note-selection-indicator" style="flex-grow: 1; margin-top: -10px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="main-container" class="graph-note-container" style="flex-grow: 1; border-top-right-radius: 0; border-top-left-radius: 0; min-width: auto; min-height: auto;">
            <ui:VisualElement name="note-header" class="graph-note-header">
                <ui:TextField name="note-title" multiline="false" select-all-on-focus="true" select-all-on-mouse-up="true" label="" class="graph-note-title" style="font-size: 20px;"/>
                <editor:ColorField name="note-text-color" show-alpha="true" show-eye-dropper="false" class="graph-note-text-color"/>
                <editor:ColorField name="note-color" show-alpha="true" show-eye-dropper="false" class="graph-note-color"/>
            </ui:VisualElement>
            <ui:VisualElement name="note-divider" class="graph-note-divider"/>
            <ui:TextField name="note-contents" multiline="true" select-all-on-focus="true" select-all-on-mouse-up="true" class="graph-note-contents" style="padding-bottom: 20px;"/>
            <ui:VisualElement name="resize-background" style="flex-grow: 1; overflow: hidden; position: absolute; bottom: -1px; right: -1px; height: 32px; width: 32px; background-image: url(&quot;project://database/Assets/Scripts/BehaviourTree/Editor/UITextures/resize-icon-bg.png?fileID=2800000&amp;guid=e5f21d484314f5648b91bfbbb9902047&amp;type=3#resize-icon-bg&quot;); -unity-background-image-tint-color: rgb(56, 56, 56); margin-right: 0; margin-bottom: 0; border-bottom-right-radius: 0;"/>
            <ui:VisualElement name="resize-background-border" style="flex-grow: 1; overflow: hidden; position: absolute; bottom: -3px; right: -3px; height: 34px; width: 34px; margin-right: 0; margin-bottom: 0; border-bottom-right-radius: 4px; border-top-width: 0; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 0; border-left-color: rgb(23, 23, 23); border-right-color: rgb(23, 23, 23); border-top-color: rgb(23, 23, 23); border-bottom-color: rgb(23, 23, 23); border-top-right-radius: 1px; border-bottom-left-radius: 1px; display: flex; visibility: visible;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
