#LockToggle > .unity-toggle__input > .unity-toggle__text {
    display: none;
}

#LockToggle > .unity-toggle__input > .unity-toggle__checkmark {
    display: none;
}

#LockToggle {
    width: 24px;
    height: 24px;
    border-width: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 3px;
    margin-right: 8px;
    margin-bottom: 3px;
    margin-left: 0;
}

#LockToggle:checked {
    background-color: rgba(0, 0, 0, 0.4);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.toggle {
    flex-grow: 1;
    left: 164px;
    top: 10px;
    background-color: rgba(37, 37, 37, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.toggle:hover {
    background-color: rgba(25, 25, 25, 0.75);
}

.toggle:checked {
    background-color: rgb(45, 46, 49);
}
