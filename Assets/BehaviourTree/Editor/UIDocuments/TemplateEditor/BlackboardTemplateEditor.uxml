<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True" style="flex-grow: 1;">
    <Style src="project://database/Assets/BehaviourTree/Editor/UIDocuments/TemplateEditor/BlackboardTemplateEditor.uss?fileID=7433441132597879392&amp;guid=bd8e0a11b32479846ad329edb2e6f3eb&amp;type=3#BlackboardTemplateEditor"/>
    <Style src="project://database/Assets/BehaviourTree/Editor/UIDocuments/TabContentStyle.uss?fileID=7433441132597879392&amp;guid=8f92422b15060c441845a2cf4623c6d8&amp;type=3#TabContentStyle"/>
    <uie:Toolbar>
        <uie:ToolbarMenu text="Template" name="template-bar-menu"/>
    </uie:Toolbar>
    <ui:VisualElement name="content-area" style="margin-bottom: 24px; margin-top: 8px; padding-bottom: 28px; flex-grow: 1;">
        <ui:Label text="Blackboard Template Editor" name="title-header" class="tab-title" style="font-size: 18px; border-top-width: 0; border-right-width: 0; border-bottom-width: 2px; border-left-width: 0; padding-bottom: 10px; -unity-text-align: upper-center; margin-bottom: 1px;"/>
        <ui:VisualElement name="template-nav-row" style="flex-grow: 0; height: 45px; align-self: center; margin-bottom: 12px;">
            <ui:Button text="Create New Template" name="create-new-template-button" style="height: 100%;"/>
            <ui:Button text="Browse..." name="browse-template-button" style="height: 100%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="name-container" style="flex-grow: 0;">
            <ui:VisualElement name="section-separator" style="height: 1px; background-color: rgba(255, 255, 255, 0.1); margin-top: 6px; margin-bottom: 6px; flex-shrink: 0;"/>
            <ui:Label text="(no template loaded)" name="template-definition-name" style="font-size: 22px; -unity-text-align: middle-center; -unity-font-style: bold;"/>
            <ui:VisualElement name="section-separator" style="height: 1px; background-color: rgba(255, 255, 255, 0.1); margin-top: 6px; margin-bottom: 6px; flex-shrink: 0;"/>
        </ui:VisualElement>
        <ui:ScrollView name="sections-scroll" style="flex-grow: 1; padding-right: 0; padding-left: 0; padding-top: 4px; padding-bottom: 0; margin-right: 0; margin-left: 0;">
            <ui:VisualElement name="blackboard-container" class="element-container" style="flex-direction: column; flex-grow: 1; align-items: stretch; padding-left: 6px; padding-right: 6px; background-color: rgb(46, 46, 46); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; margin-bottom: 12px;">
                <ui:Label text="Variables" name="variables-header" class="tab-title" style="margin-bottom: 4px;"/>
                <BlackBoardView name="template-blackboard-view"/>
                <ui:Button text="Apply Template..." name="apply-button" style="height: 28px; width: 160px; align-self: center; margin-top: 8px; margin-bottom: 8px;"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
