GridBackground {
    --grid-background-color: rgba(0, 0, 0, 0);
    --line-color: rgba(193, 196, 192, 0.1);
    --thick-line-color: rgba(193, 196, 192, 0.1);
    --spacing: 35;
}

.unity-tab__content-container {
    flex-grow: 1;
    height: 100%;
}

.unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab__header:hover {
    background-color: rgb(70, 70, 70);
}

.unity-tab__header:checked {
    background-color: rgb(46, 46, 46);
}

.unity-tab__header {
    border-left-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-top-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    border-right-width: 0.1px;
    border-left-width: 0;
    background-color: rgb(58, 58, 58);
    color: rgb(190, 190, 190);
    border-bottom-width: 0;
    flex-grow: 1;
    width: auto;
}



.unity-tab {
    margin-top: 8px;
    padding-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 6px;
    margin-right: 6px;
    flex-grow: 1;
}

#GraphTitle {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-top: 12px;
    margin-right: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
    flex-direction: row;
    white-space: nowrap;
    overflow: visible;
}

#GraphTitleInput {
    -unity-font-style: bold;
    color: rgb(188, 188, 188);
    font-size: 24px;
    white-space: nowrap;
    flex-direction: row;
    flex-shrink: 0;
}

#InspectorTitle {
    color: rgb(196, 196, 196);
    -unity-font-style: normal;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 6px;
    margin-left: 2px;
}

#InspectorSeparator {
}



.tab-container-styling {
    flex-grow: 1;
}
