.entry-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 2px;
    padding-right: 2px;
}

.drag-handle {
    width: 16px;
    flex-shrink: 0;
}

.entry-fields {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

.entry-name {
    flex-shrink: 1;
    margin-bottom: 2px;
    flex-grow: 1;
    overflow: hidden;
}

.entry-type {
    flex-shrink: 1;
    margin-bottom: 2px;
    overflow: hidden;
}

.entry-stride {
    flex-shrink: 1;
    margin-bottom: 2px;
    overflow: hidden;
}

.entry-value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
}

.entry-delete {
    width: 20px;
    flex-shrink: 0;
    margin-left: 4px;
    background-color: rgb(240, 89, 95);
    color: rgb(232, 223, 223);
    border-left-color: rgb(217, 54, 68);
    border-right-color: rgb(217, 54, 68);
    border-top-color: rgb(217, 54, 68);
    border-bottom-color: rgb(217, 54, 68);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

#entry-row > .entry-fields > #stride-field > #stride-field > .unity-base-field__label--with-dragger {
    display: none;
    visibility: hidden;
    overflow: visible;
    opacity: 0;
}

.entry-delete:hover {
    background-color: rgb(240, 126, 131);
    border-left-color: rgb(217, 86, 97);
    border-right-color: rgb(217, 86, 97);
    border-top-color: rgb(217, 86, 97);
    border-bottom-color: rgb(217, 86, 97);
}

.entry-delete:hover:selected {
    background-color: rgb(197, 42, 48);
    border-left-color: rgb(217, 54, 68);
    border-right-color: rgb(217, 54, 68);
    border-top-color: rgb(217, 54, 68);
    border-bottom-color: rgb(217, 54, 68);
}
