  editorNotes:
  - position: {x: 801.5581, y: 495.1809}
    size: {x: 441.05963, y: 210.33855}
    title: Patrol Logic
    contents: "Checks the order -> Runs moving sequence\n\nSets the formation speed
      so all agents have a similair movespeed \n\nREPORT STATUS -> RUNNING to the
      COMMANDER\nREPORT STATUS -> SUCCESS/FAILURE on ACTION COMPLETE"
    noteColor: {r: 1, g: 0.92, b: 0.55, a: 0.85}
    textColor: {r: 0, g: 0, b: 0, a: 1}
  - position: {x: 2.7614098, y: 506.00018}
    size: {x: 319, y: 197}
    title: 'DETECTION '
    contents: "IF enemy has been detected. \n\nSelect & Save detected enemy\n\nsave
      slot variable is bound to the squad and will update it's agent slot in the
      commander."
    noteColor: {r: 1, g: 0.92, b: 0.55, a: 0.85}
    textColor: {r: 0, g: 0, b: 0, a: 1}
  - position: {x: -810.1054, y: 957.1453}
